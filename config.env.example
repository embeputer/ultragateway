# ultragateway configuration
# Copy to ~/Library/Application Support/ultragateway/config.env to customize.
# install.sh creates a default config if none exists.

# Path to cua-driver binary
CUA_DRIVER_BIN="/Users/ember/.local/bin/cua-driver"

# Supergateway listen port (SSE / WebSocket / Streamable HTTP)
SUPERGATEWAY_PORT=8000

# Output transport: sse | ws | streamableHttp
SUPERGATEWAY_OUTPUT_TRANSPORT=sse

# Supergateway log level: debug | info | none
SUPERGATEWAY_LOG_LEVEL=info

# Tunnel provider for remote access (Poke, etc.): tailscale | cloudflare | ngrok | none
# Recommended default: tailscale (stable https://your-mac.your-tailnet.ts.net URL)
TUNNEL_PROVIDER=tailscale

# Path appended to the public base URL for Poke MCP Server URL field
TUNNEL_MCP_PATH=/sse

# Seconds to wait for Supergateway before starting tunnel
TUNNEL_WAIT_SECONDS=120

# Native MCP tools (ultragateway_run_zsh, ultragateway_notify)
NATIVE_SHELL_ENABLED=1
NATIVE_SHELL_TIMEOUT=30
NATIVE_SHELL_TIMEOUT_MAX=300
NATIVE_NOTIFY_ENABLED=1

# Auto-update from GitHub (com.ultragateway.em.update LaunchAgent)
AUTO_UPDATE_ENABLED=1
AUTO_UPDATE_INTERVAL=21600
AUTO_UPDATE_BRANCH=main
GITHUB_REPO_URL=https://github.com/embeputer/ultragateway.git
# ULTRAGATEWAY_REPO_DIR=   # set automatically by install.sh; or path to your git clone

# Optional Bearer API key protection for the MCP HTTP surface (default off).
# Managed by the menu bar Settings UI; generate a key only when enabling.
API_KEY_PROTECTION_ENABLED=false
API_KEY=
# When protection is on, Supergateway binds an internal port (default: SUPERGATEWAY_PORT + 10000).
# SUPERGATEWAY_INTERNAL_PORT=18000

# Optional: extra PATH entries for launchd (colon-separated)
# LAUNCHD_PATH_EXTRA="/opt/homebrew/bin:/Users/ember/.npm-global/bin"
